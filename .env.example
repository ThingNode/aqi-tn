DATA_MODE=demo
API_DEV_PORT=8020
API_RELOAD=false
SIMULATION_SEED=42
SIMULATION_ONCE=false
FAULT_INJECTION=true
EXPOSURE_REFERENCE_MULTIPLIER=4
POSTGRES_PASSWORD=replace-me

# Existing ThingsBoard instance. Never expose these through VITE_* variables.
THINGSBOARD_BASE_URL=https://demo.thingsnode.cc
THINGSBOARD_WS_URL=wss://demo.thingsnode.cc/api/ws/plugins/telemetry
THINGSBOARD_USERNAME=
THINGSBOARD_PASSWORD=
# Optional when the account can access more than one tenant.
THINGSBOARD_TENANT_ID=

# Device telemetry transport. Confirm the public MQTT/TLS port with the instance.
MQTT_HOST=demo.thingsnode.cc
MQTT_PORT=1883
MQTT_TLS=false
MQTT_TLS_INSECURE=false

# A shared fallback token is only suitable for a one-device smoke test. For the
# 15-station demo, populate the station-specific TB_TOKEN_* variables below.
TB_DEVICE_TOKEN=
TB_TOKEN_STA_REF_BATTARAMULLA_01=
TB_TOKEN_STA_REF_BATTARAMULLA_02=
TB_TOKEN_STA_BG_DIYAWANNA=
TB_TOKEN_STA_COR_KANDY_PELIYAGODA=
TB_TOKEN_STA_COR_NEGOMBO_WATTALA=
TB_TOKEN_STA_COR_GALLE_BAMBALAPITIYA=
TB_TOKEN_STA_COR_HLR_NUGEGODA=
TB_TOKEN_STA_COR_BASELINE_BORELLA=
TB_TOKEN_STA_SCH_PELIYAGODA=
TB_TOKEN_STA_SCH_WATTALA=
TB_TOKEN_STA_SCH_BAMBALAPITIYA=
TB_TOKEN_STA_SCH_NUGEGODA=
TB_TOKEN_STA_IND_PORT=
TB_TOKEN_STA_IND_KELANIYA=
TB_TOKEN_STA_COAST_GALLE_FACE=
